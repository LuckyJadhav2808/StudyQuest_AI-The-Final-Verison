rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ──
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. User Profiles and Private Subcollections
    // Public profile reading allowed for social/leaderboard/friends.
    // Writes strictly isolated to the authenticated document owner.
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);

      // Private Subcollections (tasks, notes, habits, dsaProgress, inventory, etc.)
      match /{subcollection=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // 2. Global Shared DSA Problems Collection
    // Read-only for standard users to prevent malicious data tampering or question deletion.
    match /globalDsaProblems/{problemId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // 3. Groups & Study Rooms
    // Authenticated users can read groups. Creating requires authentication.
    // Modifying or deleting is guarded by ownership.
    match /groups/{groupId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.createdBy == request.auth.uid ||
        (resource.data.admins != null && request.auth.uid in resource.data.admins)
      );

      match /{subcollection=**} {
        allow read, write: if isAuthenticated();
      }
    }

    // 4. Friend Requests
    // Only participants (sender or recipient) can read, accept, reject, or delete their requests.
    match /friendRequests/{requestId} {
      allow create: if isAuthenticated() && request.resource.data.fromUid == request.auth.uid;
      allow read, update, delete: if isAuthenticated() && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toUid == request.auth.uid ||
        request.resource.data.fromUid == request.auth.uid
      );
    }

    // 5. User Online Presence Status
    match /presence/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // 6. Global Leaderboard
    // Users can only write/update their OWN document (matching their authenticated UID).
    match /leaderboard/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == docId;
    }

    // 7. Bug Reports & Feedback
    match /bugReports/{reportId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated();
    }

    // 8. System AI Usage & Analytics
    // Protected: telemetry is written server-side; read-only for authenticated clients.
    match /systemAiUsage/{date} {
      allow read: if isAuthenticated();
      allow write: if false;
    }
  }
}
